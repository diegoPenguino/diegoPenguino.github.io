rules_version = '2';

// Blog comments for penguino.space, and the bots people upload to Domain Expansion
// (https://penguino.space/Domain-Expansion/).
// Paste this into Firebase console -> Firestore -> Rules, or deploy with
// `firebase deploy --only firestore:rules` from the firebase/ folder.
//
// Data model:
//   posts/{postId}/comments/{commentId}  { uid, name, photo?, text, parent, createdAt }
//   users/{uid}                          { lastCommentAt }  (rate limit, never readable)
//   users/{uid}/bots/{slot}              { uid, ownerName, name, code, createdAt, updatedAt }
//                                        slot is "1".."5", so each user has at most 5 bots
//   botLimits/{uid}                      { lastSaveAt }  (rate limit, never readable)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The site owner can delete any comment.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'diegoangulo5@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && postId.matches('^[A-Za-z0-9_-]{1,120}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'text', 'parent', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'parent', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string
                && request.resource.data.photo.size() <= 500
                && request.resource.data.photo.matches('^https://.*')))
        && request.resource.data.text is string
        && request.resource.data.text.trim().size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        // Replies go one level deep: the parent must exist and be a top-level comment.
        && (request.resource.data.parent == null
            || (request.resource.data.parent is string
                && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parent))
                && get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parent)).data.parent == null))
        // Rate limit: the same batch must stamp users/{uid}.lastCommentAt, and the
        // previous comment from this user must be at least 30 seconds old.
        && getAfter(userDoc()).data.lastCommentAt == request.time
        && (!exists(userDoc())
            || get(userDoc()).data.lastCommentAt < request.time - duration.value(30, 's'));

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastCommentAt'])
        && request.resource.data.lastCommentAt == request.time;
      allow delete: if false;
    }

    // ---------- Domain Expansion bots ----------

    function botLimitDoc() {
      return /databases/$(database)/documents/botLimits/$(request.auth.uid);
    }

    function validBot(uid) {
      let bot = request.resource.data;
      return bot.keys().hasOnly(['uid', 'ownerName', 'name', 'code', 'createdAt', 'updatedAt'])
        && bot.keys().hasAll(['uid', 'ownerName', 'name', 'code', 'createdAt', 'updatedAt'])
        && bot.uid == uid
        && bot.ownerName is string
        && bot.ownerName.size() >= 1
        && bot.ownerName.size() <= 80
        && bot.name is string
        && bot.name.trim().size() >= 1
        && bot.name.size() <= 40
        && bot.code is string
        && bot.code.trim().size() >= 1
        && bot.code.size() <= 20000
        && bot.updatedAt == request.time;
    }

    // Rate limit: the same batch must stamp botLimits/{uid}.lastSaveAt, and the previous
    // save from this user must be at least 10 seconds old.
    function botSaveAllowed() {
      return getAfter(botLimitDoc()).data.lastSaveAt == request.time
        && (!exists(botLimitDoc())
            || get(botLimitDoc()).data.lastSaveAt < request.time - duration.value(10, 's'));
    }

    // Anyone can read every bot: the code is public. Written with {path=**} so the page
    // can list all users' bots with one collectionGroup('bots') query.
    match /{path=**}/bots/{slot} {
      allow read: if true;
    }

    match /users/{uid}/bots/{slot} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && slot.matches('^[1-5]$')
        && validBot(uid)
        && request.resource.data.createdAt == request.time
        && botSaveAllowed();

      allow update: if signedIn()
        && request.auth.uid == uid
        && validBot(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && botSaveAllowed();

      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /botLimits/{uid} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSaveAt'])
        && request.resource.data.lastSaveAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
